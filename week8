    "import os\n",
    "\n",
    "os.makedirs(\"lab_data/input\", exist_ok=True)\n",
    "os.makedirs(\"lab_data/output\", exist_ok=True)\n",
    "os.makedirs(\"lab_data/logs\", exist_ok=True)\n",
    "\n",
    "for item in os.listdir(\"lab_data\"):\n",
    "    item_path = os.path.join(\"lab_data\", item)\n",
    "    if os.path.isfile(item_path):\n",
    "        print(item, \"File\")\n",
    "    else:\n",
    "        print(item, \"Directory\")\n",
    "\n",
    "os.rename(\"lab_data/logs\", \"lab_data/history\")"
   ]
