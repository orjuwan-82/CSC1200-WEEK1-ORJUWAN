    "class Person:\n",
    "\n",
    "    def __init__(self, name, age):\n",
    "        self.name = name\n",
    "        self.age = age\n",
    "\n",
    "\n",
    "p = Person(\"Arjwan\", 20)\n",
    "\n",
    "p.age = 21\n",
    "\n",
    "print(\"Name:\", p.name)\n",
    "print(\"Age:\", p.age)"
   ]
