   "source": [
    "class Employee:\n",
    "\n",
    "    def __init__(self, name, salary):\n",
    "        self.name = name\n",
    "        self.salary = salary\n",
    "\n",
    "\n",
    "class Manager(Employee):\n",
    "\n",
    "    def add_bonus(self, bonus):\n",
    "        self.salary = self.salary + bonus\n",
    "\n",
    "    def display(self):\n",
    "        print(\"Name:\", self.name)\n",
    "        print(\"Total Salary:\", self.salary)\n",
    "\n",
    "\n",
    "m = Manager(\"Arjwan\", 5000)\n",
    "\n",
    "m.add_bonus(1000)\n",
    "\n",
    "m.display()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e7102c58-6344-4b6c-a848-69d4832230f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Student:\n",
    "\n",
    "    def __init__(self):\n",
    "        self.name = input(\"Enter name: \")\n",
    "\n",
    "        try:\n",
    "            age = int(input(\"Enter age: \"))\n",
    "            if age < 0:\n",
    "                raise ValueError\n",
    "            self.age = age\n",
    "        except ValueError:\n",
    "            print(\"Error: invalid age\")\n",
    "            self.age = None\n",
    "\n",
    "    def display(self):\n",
    "        print(\"Name:\", self.name)\n",
    "        print(\"Age:\", self.age)\n",
    "\n",
    "\n",
    "s = Student()\n",
    "s.display()"
   ]
  }
