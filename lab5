    "import re\n",
    "import math\n",
    "\n",
    "password = input(\"Enter a password: \")\n",
    "\n",
    "upper = re.search(r\"[A-Z]\", password)\n",
    "lower = re.search(r\"[a-z]\", password)\n",
    "number = re.search(r\"[0-9]\", password)\n",
    "\n",
    "if upper and lower and number:\n",
    "    print(\"Password is strong\")\n",
    "else:\n",
    "    print(\"Password is weak\")\n",
    "\n",
    "def average(scores):\n",
    "    return sum(scores)/len(scores)\n",
    "\n",
    "data = input(\"Enter 5 scores separated by spaces: \")\n",
    "\n",
    "scores = list(map(float, data.split()))\n",
    "\n",
    "avg = average(scores)\n",
    "\n",
    "round_avg = math.ceil(avg)\n",
    "\n",
    "print(\"Rounded average score:\", round_avg)"
   ]
