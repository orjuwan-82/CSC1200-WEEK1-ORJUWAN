    "import math\n",
    "\n",
    "def area(r):\n",
    "    return math.pi * r * r\n",
    "\n",
    "r = float(input(\"Enter the radius of a circle: \"))\n",
    "\n",
    "circumference = lambda r: 2 * math.pi * r\n",
    "\n",
    "a = round(area(r), 2)\n",
    "c = round(circumference(r), 2)\n",
    "\n",
    "print(\"Area:\", format(a, \".2f\"))\n",
    "print(\"Circumference:\", format(c, \".2f\"))"
   ]
