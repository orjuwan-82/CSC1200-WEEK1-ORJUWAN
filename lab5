    "import math\n",
    "\n",
    "def square_numbers(nums):\n",
    "    return list(map(lambda x: x*x, nums))\n",
    "\n",
    "data = input(\"Enter numbers separated by commas: \")\n",
    "\n",
    "nums = list(map(float, data.split(\",\")))\n",
    "\n",
    "squares = square_numbers(nums)\n",
    "\n",
    "max_square = max(squares)\n",
    "\n",
    "sqrt_sum = math.sqrt(sum(squares))\n",
    "\n",
    "print(\"Squares:\", squares)\n",
    "print(\"Maximum square:\", max_square)\n",
    "print(\"Square root of sum of squares:\", sqrt_sum)"
   ]
