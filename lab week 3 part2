    "score = int(input(\"Enter student score: \"))\n",
    "if score >=50:\n",
    "    print(\"Passed\")\n",
    "else:\n",
    "    print(\"Failed\")\n",
    "if score >= 90:\n",
    "    grade = \"A\"\n",
    "elif score >= 80:\n",
    "    grade = \"B\"\n",
    "elif score >= 70:\n",
    "    grade =\"C\"\n",
    "elif score >= 60:\n",
    "    grade = \"D\"\n",
    "else:\n",
    "    grade = \"F\"\n",
    "match grade:\n",
    "    case \"A\":\n",
    "        print(\"Excellent!\")\n",
    "    case \"B\":\n",
    "        print(\"Very Good!\")\n",
    "    case \"C\":\n",
    "        print(\"Good\")\n",
    "    case \"D\":\n",
    "        print(\"Pass\")\n",
    "    case \"F\":\n",
    "        print(\"Fail\")"
   ]
