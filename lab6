    "nums = []\n",
    "\n",
    "for i in range(5):\n",
    "    n = float(input(\"Enter a number: \"))\n",
    "    nums.append(n)\n",
    "\n",
    "print(\"Sum:\", sum(nums))\n",
    "print(\"Average:\", sum(nums)/len(nums))\n",
    "print(\"Maximum:\", max(nums))\n",
    "print(\"Minimum:\", min(nums))"
   ]
