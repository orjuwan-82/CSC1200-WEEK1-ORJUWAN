   "source": [
    "students = {}\n",
    "\n",
    "for i in range(3):\n",
    "    name = input(\"Enter student name: \")\n",
    "    score = float(input(\"Enter score: \"))\n",
    "    students[name] = score\n",
    "\n",
    "print(\"Students and scores:\")\n",
    "for k,v in students.items():\n",
    "    print(k, v)\n",
    "\n",
    "highest = max(students, key=students.get)\n",
    "\n",
    "print(\"Highest score student:\", highest)"
   ]
