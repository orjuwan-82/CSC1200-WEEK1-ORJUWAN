    "import random\n",
    "secret = random.randint(1, 20)\n",
    "attempts = 0\n",
    "while True:\n",
    "    guess = int(input(\"Guess a number between 1 and 20: \"))\n",
    "    if guess < 1 or guess > 20:\n",
    "        continue\n",
    "    attempts += 1\n",
    "    if guess == secret:\n",
    "        print(\"Correct! Attempts:\", attempts)\n",
    "        break"
   ]
